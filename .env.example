# Optional: Formspree form endpoint for email signups
# Create a form at https://formspree.io and paste the endpoint, e.g.:
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=

# Public site URL used when generating a QR code after deploy, and for
# Stripe's return links after payment (falls back to the request origin).
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
NEXT_PUBLIC_SITE_URL=

# Which Stripe keys new checkouts use: "test" (test cards only) or "live" (real payments).
# Anything other than "live" is treated as test. Redeploy after changing it on Vercel.
STRIPE_MODE=test

# Test mode: Stripe Dashboard (Test mode / Sandbox) → Developers → API keys → sk_test_...
STRIPE_TEST_SECRET_KEY=
# Signing secret (whsec_...) of the TEST webhook pointing at /api/stripe/webhook.
# Locally, `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints one.
STRIPE_TEST_WEBHOOK_SECRET=

# Live mode: Stripe Dashboard (live) → Developers → API keys → sk_live_...
STRIPE_LIVE_SECRET_KEY=
# Signing secret (whsec_...) of the LIVE webhook pointing at /api/stripe/webhook.
STRIPE_LIVE_WEBHOOK_SECRET=

# Gmail account that sends order notification emails, plus a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=stevenagefilbritc@gmail.com
GMAIL_APP_PASSWORD=
# Optional: where order emails go (defaults to the contact email in src/config/event.ts).
ORDER_NOTIFICATION_EMAIL=
